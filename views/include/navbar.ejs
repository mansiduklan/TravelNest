
<style>
  .search-btn,.search-btn i{
    border-radius: 15px;
    color:white;
    background-color: #2563EB;
    display: inline;
    border: none;
    padding: 0.5rem;
  }
  .form-control{
    border-radius: 15px;
  }
  .search-btn:hover{
